---
import Layout from "../layouts/Layout.astro";
import products from "../data/products.json";

interface Product {
  id: string;
  name: string;
  description: string;
  formattedPrice: string;
  url: string;
  coverImage?: string;
}

const items = products as Product[];
---

<Layout title="Çocuklar için sıcacık hikaye kitapları">
  <section class="mx-auto max-w-5xl px-6 pt-16 pb-12 text-center">
    <p class="font-heading text-sm tracking-wide text-teal uppercase mb-3">Merhaba, biz TaleBerry'iz</p>
    <h1 class="font-heading text-4xl sm:text-5xl font-700 leading-tight text-ink">
      Çocukların duygularını anlamasına<br class="hidden sm:block" /> yardımcı olan hikaye kitapları
    </h1>
    <p class="mt-5 text-lg text-ink-soft max-w-2xl mx-auto">
      Öfke yönetiminden sakinleşme köşesi aktivitelerine, uyku öncesi kaygılardan güvenli
      iletişime — her TaleBerry kitabı bir duyguyu, çocukların anlayacağı sıcacık bir hikayeyle anlatır.
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-20">
    {items.length === 0 ? (
      <div class="rounded-3xl border border-line bg-cream-2 px-8 py-16 text-center">
        <p class="font-heading text-2xl text-coral-dark mb-2">İlk kitabımız çok yakında burada! 🌟</p>
        <p class="text-ink-soft">Hazırlıklar sürüyor — ilk kitabımız yayınlanır yayınlanmaz burada göreceksin.</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {items.map((p) => (
          <a
            href={p.url}
            target="_blank"
            rel="noreferrer"
            class="group rounded-2xl border border-line bg-white overflow-hidden hover:shadow-lg hover:-translate-y-1 transition-all"
          >
            {p.coverImage && (
              <img src={p.coverImage} alt={p.name} class="w-full aspect-[3/4] object-cover" />
            )}
            <div class="p-5">
              <h3 class="font-heading text-lg text-ink group-hover:text-coral-dark transition-colors">{p.name}</h3>
              <p class="text-sm text-ink-soft mt-1 line-clamp-2">{p.description}</p>
              <p class="mt-3 font-700 text-coral-dark">{p.formattedPrice}</p>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
</Layout>
