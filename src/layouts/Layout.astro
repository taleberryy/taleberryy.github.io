---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "TaleBerry — warm storybooks for kids." } = Astro.props;
const siteName = "TaleBerry";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · {siteName}</title>

    <meta property="og:title" content={`${title} · ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-L8PB6S3HV7"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", "G-L8PB6S3HV7");
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="border-b border-line bg-cream/90 backdrop-blur sticky top-0 z-40">
      <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
        <a href="/" class="font-heading text-xl font-700 text-coral-dark">🍓 TaleBerry</a>
        <div class="flex items-center gap-6 text-sm font-600 text-ink-soft">
          <a href="/" class="hover:text-coral-dark transition-colors">Books</a>
          <a href="/blog" class="hover:text-coral-dark transition-colors">Blog</a>
        </div>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-line mt-16">
      <div class="mx-auto max-w-5xl px-6 py-10 text-sm text-ink-soft flex flex-col sm:flex-row items-center justify-between gap-3">
        <p>© {new Date().getFullYear()} TaleBerry. All rights reserved.</p>
        <p>Warm stories for kids growing up with confidence.</p>
      </div>
    </footer>
  </body>
</html>
